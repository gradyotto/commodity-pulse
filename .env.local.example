# ─────────────────────────────────────────────────────────────────────────────
# Commodity Pulse — Environment Variables
# Copy this file to .env.local and fill in your keys.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic (required) — get at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# FRED — Federal Reserve Economic Data (required for commodity/shipping data)
# Free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Alpha Vantage (optional — enhances real-time commodity prices)
# Free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Vercel KV (required for brief caching — prevents Claude API abuse)
# Set up at: vercel.com → your project → Storage → Create KV Database
# Then run: vercel env pull .env.local  (auto-populates these)
KV_REST_API_URL=your_kv_rest_api_url
KV_REST_API_TOKEN=your_kv_rest_api_token

# Site branding (optional — customize for your website)
NEXT_PUBLIC_SITE_NAME="Builder's Brief"
NEXT_PUBLIC_SITE_TAGLINE="Supply Chain Intelligence for Hardware & Manufacturing"
